// ─── STORAGE ──────────────────────────────────────────────────────────────────
const SK = “immo_v6”;
function loadState() {
try { const r = localStorage.getItem(SK); if (r) return JSON.parse(r); } catch {}
return null;
}
function saveState(d) { try { localStorage.setItem(SK, JSON.stringify(d)); } catch {} }
function getInitState() {
const s = loadState();
if (s) return s;
return {
modules: SEED_MODULES,
progress: { xp: 0, answered: {}, cards: {}, exams: [], days: [] },
profile: { name: “”, done: false },
};
}

// ─── HELPERS ──────────────────────────────────────────────────────────────────
const XP_TABLE = [0,100,250,450,700,1000,1400,1900,2500,3200,4000];
const RANKS = [“Einsteiger”,“Lernender”,“Anwärter”,“Praktikant”,“Junior Makler”,“Makler”,“Senior Makler”,“Experte”,“Profi”,“Meister”,“Elite”];
function getLvl(xp) {
let lv = 1;
for (let i = 1; i < XP_TABLE.length; i++) { if (xp >= XP_TABLE[i]) lv = i + 1; else break; }
lv = Math.min(lv, XP_TABLE.length);
const cur = XP_TABLE[lv-1]||0, nxt = XP_TABLE[lv]||XP_TABLE[XP_TABLE.length-1];
const pct = nxt > cur ? Math.round(((xp-cur)/(nxt-cur))*100) : 100;
return { lv, rank: RANKS[lv-1]||“Elite”, pct: Math.max(0, Math.min(100, pct)), toNext: Math.max(0, nxt-xp) };
}
function todayStr() { return new Date().toISOString().slice(0,10); }
function makeId() { return “*” + Date.now() + “*” + Math.random().toString(36).slice(2,5); }
const LETTERS = [“A”,“B”,“C”,“D”];

