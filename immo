function PageExam({ data, addExam }) {
const mods = data.modules || [];
const [started, setStarted] = useState(false);
const [examQs, setExamQs] = useState([]);
const [ans, setAns] = useState({});
const [result, setResult] = useState(null);
const [tl, setTl] = useState(0);
const [cfg, setCfg] = useState({ count: 10, mins: 15, pass: 70 });
const tiRef = useRef(null);
const finishFn = useRef(null);

useEffect(() => {
if (!started || result) return;
tiRef.current = setInterval(() => {
setTl(p => {
if (p <= 1) { clearInterval(tiRef.current); return 0; }
return p - 1;
});
}, 1000);
return () => clearInterval(tiRef.current);
}, [started, result]);

useEffect(() => {
if (started && !result && tl === 0 && examQs.length > 0) {
if (finishFn.current) finishFn.current();
}
}, [tl, started, result, examQs.length]);

const totalAvail = mods.reduce((s, m) => s + (m.questions?.length || 0), 0);

function startExam() {
const all = mods.flatMap(m => (m.questions || []).map(q => ({ …q, modTitle: m.title, modId: m.id })));
const sh = […all].sort(() => Math.random() - 0.5).slice(0, Math.min(cfg.count, all.length));
setExamQs(sh);
setAns({});
setResult(null);
setTl(cfg.mins * 60);
setStarted(true);
}

function finish() {
clearInterval(tiRef.current);
const corr = examQs.filter(q => ans[q.id] === q.correctIndex).length;
const pct = examQs.length > 0 ? Math.round((corr / examQs.length) * 100) : 0;
const res = { correct: corr, total: examQs.length, percent: pct, passed: pct >= cfg.pass, date: new Date().toISOString() };
setResult(res);
addExam(res);
}
finishFn.current = finish;

if (result) return (
