function PageStats({ data, lvl }) {
const { progress, modules = [] } = data;
const aq = progress.answered || {};
const totalQ = modules.reduce((s, m) => s + (m.questions?.length || 0), 0);
const answN = Object.keys(aq).length;
const corrN = Object.values(aq).filter(a => a.correct).length;
const acc = answN > 0 ? Math.round((corrN / answN) * 100) : 0;
const cardN = Object.keys(progress.cards || {}).length;
const totalC = modules.reduce((s, m) => s + (m.cards?.length || 0), 0);
const exams = progress.exams || [];
const avgE = exams.length > 0 ? Math.round(exams.reduce((s, e) => s + e.percent, 0) / exams.length) : 0;

return (
<div>
<PH ew="Analyse" title="Statistik" />
<div className=“g4” style={{ marginBottom: 14 }}>
<StatCard val={progress.xp} label="Gesamt XP" />
<StatCard val={acc + “%”} label=“Genauigkeit” />
<StatCard val={answN + “/” + totalQ} label=“Fragen” />
<StatCard val={cardN + “/” + totalC} label=“Karten” />
</div>
<div className=“g2” style={{ marginBottom: 14 }}>
<div className="card">
<h4 className="st">📊 Fortschritt je Modul</h4>
{modules.map(m => {
const mQ = m.questions?.length || 0;
const mA = Object.values(aq).filter(a => a.modId === m.id).length;
const mC = Object.values(aq).filter(a => a.modId === m.id && a.correct).length;
const pct = mQ > 0 ? Math.min(100, Math.round((mA / mQ) * 100)) : 0;
const macc = mA > 0 ? Math.round((mC / mA) * 100) : 0;
return (
<div key={m.id} style={{ marginBottom: 13 }}>
<div style={{ display: “flex”, justifyContent: “space-between”, marginBottom: 3 }}>
<span style={{ fontSize: 12.5, fontWeight: 700 }}>{m.icon} {m.title}</span>
<span style={{ fontSize: 11, color: “#948c80” }}>{mA}/{mQ} · {macc}%</span>
</div>
<div className="pb"><div className=“pf” style={{ width: pct + “%” }} /></div>
</div>
);
})}
</div>
<div className="card">
<h4 className="st">✏️ Prüfungshistorie</h4>
{exams.length === 0 ? (
<p style={{ fontSize: 12.5, color: “#948c80” }}>Noch keine Prüfungen.</p>
) : (
<div>
<div className=“notice n-i” style={{ marginBottom: 11 }}>Ø {avgE}% · {exams.filter(e => e.passed).length}/{exams.length} bestanden</div>
{exams.slice(-6).reverse().map((e, i) => (
<div key={i} style={{ display: “flex”, justifyContent: “space-between”, alignItems: “center”, padding: “8px 0”, borderBottom: “1.5px solid #d8d2c8” }}>
<span className={“tag “ + (e.passed ? “t-g” : “t-r”)}>{e.passed ? “✓” : “✗”} {e.correct}/{e.total}</span>
<strong style={{ fontFamily: “‘Fraunces’,serif”, fontSize: 19, color: e.passed ? “#1e6e43” : “#b52a1e” }}>{e.percent}%</strong>
</div>
))}
</div>
)}
</div>
</div>
<div className="card">
<h4 className="st">🏅 Level</h4>
<div style={{ display: “flex”, gap: 13, alignItems: “center”, flexWrap: “wrap” }}>
<div style={{ width: 50, height: 50, borderRadius: 13, background: “#fef6ec”, border: “2px solid #f2d49a”, display: “grid”, placeItems: “center”, flexShrink: 0 }}>
<span style={{ fontFamily: “‘Fraunces’,serif”, fontSize: 22, color: “#b8712a” }}>{lvl.lv}</span>
</div>
<div style={{ flex: 1, minWidth: 140 }}>
<div style={{ fontWeight: 700, marginBottom: 3 }}>{lvl.rank}</div>
<div className="xp-bar"><div className=“xp-fill” style={{ width: lvl.pct + “%” }} /></div>
<div style={{ fontSize: 11, color: “#948c80”, marginTop: 3 }}>{data.progress.xp} XP · noch {lvl.toNext} bis Lv {lvl.lv + 1}</div>
</div>
</div>
</div>
</div>
);
}

